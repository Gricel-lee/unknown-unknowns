mdp

// SHARED COIN WITH TWO SERVERS (simplified from the PRISM consensus/coin2 benchmark [AH90])
// Two servers must agree on a coin outcome. A shared counter starts in the middle; each
// round we ask ONE server to flip its coin (heads +1, tails -1). The servers agree when the
// counter reaches either end. Each flip has a latency (ms) that depends on the environment,
// so the controller decides which server to ask, minimising the expected total latency.
//
// Template with 0 unknown variables: a single environment.
// The constants below have no value; the controller fills them in.

const int K = 2; // agreement: the counter must move K steps away from the middle

// --- rewards (filled by the controller) -----
// cA = latency of a flip on server A
const double c1 = 21.854262036469596;
const double c2 = 25.8369746348544;

// --- readable views of the environment (derived from env_id) -----
formula env_set = env_id != 0;

module environment
  env_id : [0..1] init 0; // 0 = not set, 1..1 = set

  // only one environment, so it is set with probability 1
  [] env_id=0 -> 1 : (env_id'=1);
endmodule

formula agreed = counter=0 | counter=2*K;

module shared_coin
  counter : [0..2*K] init K; // K = undecided middle, 0 = agree tails, 2K = agree heads

  // nondeterministic choice: which server flips next (each coin is fair)
  [flip1] env_set & !agreed -> 0.5 : (counter'=counter+1) + 0.5 : (counter'=counter-1);
  [flip2] env_set & !agreed -> 0.5 : (counter'=counter+1) + 0.5 : (counter'=counter-1);

  // absorbing once the servers agree (avoids deadlock warnings)
  [done] agreed -> 1 : true;
endmodule

rewards "latency"
  [flip1] env_id=1 : c1;

  [flip2] env_id=1 : c2;
endrewards

label "agreed" = agreed;
