mdp

// SHARED COIN WITH TWO SERVERS (simplified from the PRISM consensus/coin2 benchmark [AH90])
// Two servers must agree on a coin outcome. A shared counter starts in the middle; each
// round we ask ONE server to flip its coin (heads +1, tails -1). The servers agree when the
// counter reaches either end. Each flip has a latency (ms) that depends on the environment,
// so the controller decides which server to ask, minimising the expected total latency.
//
// Template with 3 unknown variables u1, u2, u3 (u1=remote, u2=busy, u3=congested), each with values 0/1.
// The constants below have no value; the controller fills them in.

const int K = 2; // agreement: the counter must move K steps away from the middle

// --- probabilities (filled by the controller) -----
// pXYZ = probability of remote=X, busy=Y, congested=Z
const double p000 = 0.193; // env_id=1
const double p100 = 0.146; // env_id=2
const double p010 = 0.155; // env_id=3
const double p110 = 0.105; // env_id=4
const double p001 = 0.132; // env_id=5
const double p101 = 0.101; // env_id=6
const double p011 = 0.111; // env_id=7
const double p111 = 0.057; // env_id=8

// --- rewards (filled by the controller) -----
// cA_XYZ = latency of a flip on server A when remote=X, busy=Y, congested=Z
const double c1_000 = 10.117503052537764;
const double c1_100 = 10.100238260830686;
const double c1_010 = 30.101637015944082;
const double c1_110 = 30.06026938784448;
const double c1_001 = 19.94464670403801;
const double c1_101 = 20.1043335163577;
const double c1_011 = 39.93965447996589;
const double c1_111 = 39.73796230295127;
const double c2_000 = 12.00998197016249;
const double c2_100 = 37.16570936218887;
const double c2_010 = 11.761039116424605;
const double c2_110 = 36.9084544306335;
const double c2_001 = 21.81239350438681;
const double c2_101 = 47.21809376034691;
const double c2_011 = 22.042311822462075;
const double c2_111 = 47.057780708877395;

// --- readable views of the environment (derived from env_id) -----
formula env_set = env_id != 0;
formula u1      = (env_id=2 | env_id=4 | env_id=6 | env_id=8) ? 1 : 0;
formula u2      = (env_id=3 | env_id=4 | env_id=7 | env_id=8) ? 1 : 0;
formula u3      = (env_id=5 | env_id=6 | env_id=7 | env_id=8) ? 1 : 0;

module environment
  env_id : [0..8] init 0; // 0 = not set, 1..8 = set

  // sample the environment once, at the start
  [] env_id=0 -> p000 : (env_id'=1)
               + p100 : (env_id'=2)
               + p010 : (env_id'=3)
               + p110 : (env_id'=4)
               + p001 : (env_id'=5)
               + p101 : (env_id'=6)
               + p011 : (env_id'=7)
               + p111 : (env_id'=8);
endmodule

formula agreed = counter=0 | counter=2*K;

module shared_coin
  counter : [0..2*K] init K; // K = undecided middle, 0 = agree tails, 2K = agree heads

  // nondeterministic choice: which server flips next (each coin is fair)
  [flip1] env_set & !agreed -> 0.5 : (counter'=counter+1) + 0.5 : (counter'=counter-1);
  [flip2] env_set & !agreed -> 0.5 : (counter'=counter+1) + 0.5 : (counter'=counter-1);

  // absorbing once the servers agree (avoids deadlock warnings)
  [done] agreed -> 1 : true;
endmodule

rewards "latency"
  [flip1] env_id=1 : c1_000;
  [flip1] env_id=2 : c1_100;
  [flip1] env_id=3 : c1_010;
  [flip1] env_id=4 : c1_110;
  [flip1] env_id=5 : c1_001;
  [flip1] env_id=6 : c1_101;
  [flip1] env_id=7 : c1_011;
  [flip1] env_id=8 : c1_111;

  [flip2] env_id=1 : c2_000;
  [flip2] env_id=2 : c2_100;
  [flip2] env_id=3 : c2_010;
  [flip2] env_id=4 : c2_110;
  [flip2] env_id=5 : c2_001;
  [flip2] env_id=6 : c2_101;
  [flip2] env_id=7 : c2_011;
  [flip2] env_id=8 : c2_111;
endrewards

label "agreed" = agreed;
