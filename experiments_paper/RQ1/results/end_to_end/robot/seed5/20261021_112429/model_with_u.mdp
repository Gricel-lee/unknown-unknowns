mdp

// Template with 3 unknown variables u1, u2, u3 (u1=light, u2=wet, u3=busy), each with values 0/1.
// The constants below have no value; the controller fills them in.

// --- probabilities (filled by the controller) -----
// pXYZ = probability of light=X, wet=Y, busy=Z
const double p000 = 0.111; // env_id=1
const double p100 = 0.225; // env_id=2
const double p010 = 0.098; // env_id=3
const double p110 = 0.098; // env_id=4
const double p001 = 0.1; // env_id=5
const double p101 = 0.173; // env_id=6
const double p011 = 0.095; // env_id=7
const double p111 = 0.1; // env_id=8

// --- rewards (filled by the controller) -----
// cA_XYZ = cost of taking actionA when light=X, wet=Y, busy=Z
const double c1_000 = 26.223839811704057;
const double c1_100 = 40.04613302946828;
const double c1_010 = 18.818878108079872;
const double c1_110 = 32.90597241287262;
const double c1_001 = 30.648635336883476;
const double c1_101 = 44.55960448839927;
const double c1_011 = 23.612743780405598;
const double c1_111 = 37.32740192129491;
const double c2_000 = 24.887504354795613;
const double c2_100 = 27.102102913798486;
const double c2_010 = 33.01431316810362;
const double c2_110 = 35.08055235050923;
const double c2_001 = 28.952664429002958;
const double c2_101 = 31.069816758954797;
const double c2_011 = 36.99067274951956;
const double c2_111 = 38.93899048621679;

// --- readable views of the environment (derived from env_id) -----
formula env_set = env_id != 0;
formula u1      = (env_id=2 | env_id=4 | env_id=6 | env_id=8) ? 1 : 0;
formula u2      = (env_id=3 | env_id=4 | env_id=7 | env_id=8) ? 1 : 0;
formula u3      = (env_id>=5) ? 1 : 0;

module environment
  env_id : [0..8] init 0; // 0 = not set, 1..8 = set

  // sample the environment once, at the start
  [] env_id=0 -> p000 : (env_id'=1)
               + p100 : (env_id'=2)
               + p010 : (env_id'=3)
               + p110 : (env_id'=4)
               + p001 : (env_id'=5)
               + p101 : (env_id'=6)
               + p011 : (env_id'=7)
               + p111 : (env_id'=8);
endmodule

module agent
  s : [0..1] init 0;      // 0 = start, 1 = end of journey
  action : [0..2] init 0; // 0 = none yet, 1 = action1, 2 = action2

  // nondeterministic choice once the environment is known
  [action1] s=0 & env_set -> 1 : (s'=1) & (action'=1);
  [action2] s=0 & env_set -> 1 : (s'=1) & (action'=2);

  // absorbing end state (avoids deadlock warnings)
  [done] s=1 -> 1 : true;
endmodule

rewards "cost"
  [action1] env_id=1 : c1_000;
  [action1] env_id=2 : c1_100;
  [action1] env_id=3 : c1_010;
  [action1] env_id=4 : c1_110;
  [action1] env_id=5 : c1_001;
  [action1] env_id=6 : c1_101;
  [action1] env_id=7 : c1_011;
  [action1] env_id=8 : c1_111;

  [action2] env_id=1 : c2_000;
  [action2] env_id=2 : c2_100;
  [action2] env_id=3 : c2_010;
  [action2] env_id=4 : c2_110;
  [action2] env_id=5 : c2_001;
  [action2] env_id=6 : c2_101;
  [action2] env_id=7 : c2_011;
  [action2] env_id=8 : c2_111;
endrewards

label "end" = s=1;
